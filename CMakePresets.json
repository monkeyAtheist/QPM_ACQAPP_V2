{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "QACQ_BUILD_TESTS": "ON" }
    },
    { "name": "debug", "displayName": "Debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "displayName": "Release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "ci",
      "displayName": "CI (Release, warnings as errors)",
      "inherits": "release",
      "cacheVariables": { "QACQ_WARNINGS_AS_ERRORS": "ON", "QACQ_BUILD_APP": "OFF" }
    },
    {
      "name": "sanitize",
      "displayName": "Debug + AddressSanitizer + UBSan (gcc/clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "QACQ_BUILD_APP": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer (gcc/clang): the lock-free buffer and the threads",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "QACQ_BUILD_APP": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "sanitize", "configurePreset": "sanitize" },
    { "name": "tsan", "configurePreset": "tsan" }
  ],
  "testPresets": [
    { "name": "fast", "displayName": "Fast tests (seconds)", "configurePreset": "release", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "fast" } } },
    { "name": "all", "displayName": "All tests", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "ci", "configurePreset": "ci", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true }, "filter": { "include": { "name": "ring|acquisition" } } }
  ]
}
